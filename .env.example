# ─── Django ───────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-50-random-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.ru,www.yourdomain.ru
DJANGO_SETTINGS_MODULE=config.settings.production

# ─── Database (PostgreSQL) ─────────────────────────────────────
DATABASE_URL=postgres://ticket_user:strong_password@localhost:5432/ticket_db

# ─── Redis (Celery broker & cache) ────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── YooKassa ─────────────────────────────────────────────────
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
YOOKASSA_WEBHOOK_SECRET=your-webhook-secret

# ─── Email (SMTP / Unisender / SendPulse) ─────────────────────
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_HOST_USER=noreply@yourdomain.ru
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=Билеты <noreply@yourdomain.ru>
ADMIN_EMAIL=admin@yourdomain.ru

# ─── Site ─────────────────────────────────────────────────────
SITE_URL=https://yourdomain.ru
SITE_NAME=Fight Night Tickets

# ─── Storage (S3-compatible / Yandex Object Storage) ──────────
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=https://storage.yandexcloud.net

# ─── Sentry ───────────────────────────────────────────────────
SENTRY_DSN=

# ─── Security ─────────────────────────────────────────────────
CSRF_TRUSTED_ORIGINS=https://yourdomain.ru,https://www.yourdomain.ru
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
